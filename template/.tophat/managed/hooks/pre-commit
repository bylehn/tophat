#!/bin/sh
# TopHat-managed: runs `tophat check` before each commit and never blocks it; CI is the gate.
# Commits are made on the host, so the check runs through the dev container when `tophat` is not
# on PATH (see rqm/template/project.md in the TopHat repository).

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

if command -v tophat >/dev/null 2>&1; then
  output=$(tophat check 2>&1)
  status=$?
elif [ -x ./th.sh ] && command -v podman >/dev/null 2>&1; then
  output=$(./th.sh --check 2>&1)
  status=$?
else
  echo "TopHat: check skipped (neither tophat nor podman is available here); CI runs it."
  exit 0
fi

printf '%s\n' "$output"
case "$status" in
  0) ;;
  1) echo "TopHat: the check found errors; CI will reject this commit until they are fixed." ;;
  # Anything else, such as the launcher refusing to start (exit 2), means nothing was checked.
  *) echo "TopHat: the check could not run (exit status $status), so nothing was checked." ;;
esac
exit 0
