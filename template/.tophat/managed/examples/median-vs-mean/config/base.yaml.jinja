# Pipeline stages of study median-vs-mean. Variants override fields in config/<variant>.yaml.
stages:
  - name: generate
    run: python scripts/generate.py --out {out} --signals {params.signals} --length {params.length} --noise {params.noise} --seed {params.seed}
    validate: python scripts/validate.py signals {out} --signals {params.signals} --length {params.length}
    code: [scripts/generate.py, scripts/validate.py]
    params: {signals: 30, length: 200, noise: gaussian, seed: 1}
    # Trial runs of the draft explore on fewer signals with another seed, so the signals that
    # decide the question stay unseen until the plan is locked.
    trial:
      params: {signals: 10, seed: 2}
  - name: filter
    run: sh scripts/filter.sh {in.signals} {out} {params.width}
    code: [scripts/filter.sh]
    inputs: {signals: stage:generate}
    params: {width: 5}
    review: >-
      Open two or three of the filtered signals: does the median column follow the step from 0
      to 1 without the spikes that the mean column keeps? Under impulse noise the spikes are large.
    external:
      slurm:
        - --time=00:10:00
  - name: score
{%- if 'julia' in languages %}
    run: julia scripts/score.jl {item} {out}
    code: [scripts/score.jl, scripts/validate.py]
{%- else %}
    run: python scripts/score.py {item} {out}
    code: [scripts/score.py, scripts/validate.py]
{%- endif %}
    inputs: {filtered: stage:filter}
    foreach: filtered
    validate: python scripts/validate.py rmse {out}
  - name: analyse
    run: python scripts/analyse.py {in.scores} {out} --resamples {params.resamples} --seed {params.seed}
    code: [scripts/analyse.py]
    inputs: {scores: stage:score}
    params: {resamples: 2000, seed: 1}
    result: result.txt
